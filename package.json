{
  "name": "whisnotes",
  "version": "0.1.0",
  "description": "AI-powered meeting transcription and analysis",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc --project tsconfig.node.json && mkdir -p dist-electron && cp electron/preload.cjs dist-electron/preload.cjs && wait-on http://localhost:5173 && ELECTRON_DISABLE_SECURITY_WARNINGS=true electron .",
    "build": "tsc && vite build && electron-builder",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "build:native": "cd native/macos && npx node-gyp configure && npx node-gyp build",
    "rebuild": "electron-rebuild -f -w better-sqlite3 && cd native/macos && npx node-gyp rebuild && cd ../..",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "preview": "vite preview",
    "start": "concurrently -k \"npm run dev\" \"npm run dev:electron\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.17.0",
    "better-sqlite3": "^11.7.0",
    "date-fns": "^3.3.1",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.344.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "wav": "^1.0.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.17",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.2",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^10.3.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.1",
    "vite-plugin-electron": "^0.28.3",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^9.1.0"
  }
}
